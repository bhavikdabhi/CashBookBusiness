<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.GlassCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_10sdp"
    android:layout_marginHorizontal="@dimen/_12sdp"
    app:cardCornerRadius="@dimen/_14sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_14sdp">

        <!-- Main Row: Avatar + Name/Role + Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Rounded Party Icon Badge -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_party_icon"
                android:layout_width="@dimen/_42sdp"
                android:layout_height="@dimen/_42sdp"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bottom_nav_active_bg"
                app:strokeColor="@color/bottom_nav_active_border"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/iv_party_icon"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_action_group"
                    app:tint="@color/primary" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Name & Badges -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginEnd="@dimen/_8sdp">

                <TextView
                    android:id="@+id/tv_party_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Party Name"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_14ssp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/_4sdp">

                    <TextView
                        android:id="@+id/tv_party_role"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_bold"
                        android:letterSpacing="0.05"
                        android:text="VENDOR"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/_8ssp"
                        android:background="@drawable/bg_badge_active"
                        android:paddingHorizontal="@dimen/_8sdp"
                        android:paddingVertical="@dimen/_3sdp" />

                    <TextView
                        android:id="@+id/tvPriorityTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:text="PRIMARY"
                        android:fontFamily="@font/roboto_bold"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_8ssp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Delete Action -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                app:cardCornerRadius="@dimen/_17sdp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/error_container"
                app:strokeColor="@color/glass_border"
                app:strokeWidth="1dp">

                <ImageButton
                    android:id="@+id/iv_delete"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_action_delete"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/_8sdp"
                    app:tint="@color/danger"
                    android:contentDescription="Delete Party" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Optional Contact Info Section -->
        <LinearLayout
            android:id="@+id/layoutContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:id="@+id/ViewLine"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/glass_border"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_8sdp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivContactIcon"
                    android:layout_width="@dimen/_13sdp"
                    android:layout_height="@dimen/_13sdp"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/tvContact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="contact@email.com"
                    android:fontFamily="@font/roboto_regular"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_10ssp"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
