<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_14sdp"
    android:layout_marginVertical="@dimen/_5sdp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="@dimen/_14sdp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_12sdp">

        <!-- Time Column (Left Side) -->
        <ImageView
            android:id="@+id/ivTimeIcon"
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:src="@drawable/ic_time"
            app:tint="@color/primary_color"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvEventName"
            app:layout_constraintEnd_toEndOf="@id/tvTimeHourMin" />

        <TextView
            android:id="@+id/tvTimeHourMin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/roboto_bold"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivTimeIcon"
            tools:text="09:30" />

        <TextView
            android:id="@+id/tvTimeAmPm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_1sdp"
            android:fontFamily="@font/roboto_regular"
            android:textColor="@color/gray"
            android:textSize="@dimen/_9ssp"
            app:layout_constraintStart_toStartOf="@id/tvTimeHourMin"
            app:layout_constraintEnd_toEndOf="@id/tvTimeHourMin"
            app:layout_constraintTop_toBottomOf="@id/tvTimeHourMin"
            tools:text="AM" />

        <!-- Vertical Divider Line -->
        <View
            android:id="@+id/viewVerticalDivider"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/_10sdp"
            android:background="@color/outline"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvTimeHourMin"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Event Content Column (Right Side) -->

        <!-- Title -->
        <TextView
            android:id="@+id/tvEventName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:fontFamily="@font/roboto_bold"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnEventOptions"
            app:layout_constraintStart_toEndOf="@id/viewVerticalDivider"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Monthly Sales Review Meeting" />

        <!-- Three Dots Options Button -->
        <ImageButton
            android:id="@+id/btnEventOptions"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/icon_threedots"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvEventName"
            app:tint="@color/gray" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvEventDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:fontFamily="@font/roboto_regular"
            android:textColor="@color/gray"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvEventName"
            app:layout_constraintTop_toBottomOf="@id/tvEventName"
            tools:text="Review of monthly sales performance, key metrics, and targets for next month." />

        <!-- Tags Container -->
        <LinearLayout
            android:id="@+id/layoutTags"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvEventName"
            app:layout_constraintTop_toBottomOf="@id/tvEventDescription">

            <!-- Tag 1 (Notebook Name) -->
            <TextView
                android:id="@+id/tvTagNotebook"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_pill"
                android:backgroundTint="@color/icon_bg_green"
                android:drawableStart="@drawable/ic_book"
                android:drawablePadding="@dimen/_4sdp"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingVertical="@dimen/_4sdp"
                android:textColor="@color/success"
                android:textSize="@dimen/_9ssp"
                android:fontFamily="@font/roboto_medium"
                app:drawableTint="@color/success"
                tools:text="Sales Notebook" />

            <!-- Tag 2 (Visibility Restriction) -->
            <TextView
                android:id="@+id/tvTagVisibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:background="@drawable/bg_chip_pill"
                android:backgroundTint="@color/icon_bg_blue"
                android:drawableStart="@drawable/ic_people_"
                android:drawablePadding="@dimen/_4sdp"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingVertical="@dimen/_4sdp"
                android:textColor="@color/primary_color"
                android:textSize="@dimen/_9ssp"
                android:fontFamily="@font/roboto_medium"
                app:drawableTint="@color/primary_color"
                tools:text="Everyone" />

        </LinearLayout>

        <!-- Creator Info Footer Row -->
        <LinearLayout
            android:id="@+id/layoutCreatorInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvEventName"
            app:layout_constraintTop_toBottomOf="@id/layoutTags">

            <!-- Creator Avatar -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivCreatorAvatar"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_avtar"
                app:shapeAppearanceOverlay="@style/CircleImageView" />

            <!-- Name and Created At text stack -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCreatedBy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_10ssp"
                    tools:text="Created by Bhavik Dabhi" />

                <TextView
                    android:id="@+id/tvCreatedAtTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_1sdp"
                    android:fontFamily="@font/roboto_regular"
                    android:textColor="@color/gray"
                    android:textSize="@dimen/_8ssp"
                    tools:text="22 Oct 2026 • 08:45 AM" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
