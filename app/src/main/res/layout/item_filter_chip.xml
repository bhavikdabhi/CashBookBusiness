<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.chip.Chip
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chip_item"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Filter"
    android:fontFamily="@font/roboto_medium"
    android:textSize="@dimen/_11ssp"
    android:layout_marginEnd="@dimen/_8sdp"
    android:textColor="@color/sel_chip_text"
    app:chipMinHeight="@dimen/_32sdp"
    app:ensureMinTouchTargetSize="false"
    app:chipCornerRadius="@dimen/_16sdp"
    app:chipBackgroundColor="@color/sel_transaction_filter_chip_bg"
    app:chipStrokeColor="@color/sel_chip_stroke"
    app:chipStrokeWidth="1dp"
    app:chipStartPadding="@dimen/_10sdp"
    app:chipEndPadding="@dimen/_6sdp"
    app:closeIconVisible="true"
    app:closeIcon="@drawable/ic_expand_more"
    app:closeIconSize="@dimen/_14sdp"
    app:closeIconTint="@color/sel_chip_text" />
