<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    >


    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/_64sdp"
        android:orientation="horizontal"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_12sdp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_glass_card"
        android:elevation="@dimen/_4sdp">

        <!-- Back Button -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            app:cardCornerRadius="@dimen/_15sdp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/stitch_surface_container_low"
            app:strokeColor="@color/glass_border"
            app:strokeWidth="1dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/ic_back"
                android:padding="@dimen/_9sdp"
                app:tint="@color/text_secondary"
                android:contentDescription="Back" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Notebook Avatar Badge -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginStart="@dimen/_8sdp"
            app:cardCornerRadius="@dimen/_12sdp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bottom_nav_active_bg"
            app:strokeColor="@color/bottom_nav_active_border"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_book"
                app:tint="@color/bottom_nav_active_border" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_8sdp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notebook Name"
                android:fontFamily="@font/roboto_medium"
                android:textFontWeight="700"
                android:textStyle="bold"
                android:textSize="@dimen/_13ssp"
                android:textColor="@color/text_secondary"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/roboto_regular"
                android:textFontWeight="500"
                android:text="Manage your daily entries"
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/on_surface_variant"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Actions Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- PDF Export Button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                app:cardCornerRadius="@dimen/_18sdp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/stitch_surface_container_low"
                app:strokeColor="@color/glass_border"
                app:strokeWidth="1dp">

                <ImageButton
                    android:id="@+id/btn_pdf"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:src="@drawable/ic_menu_report"
                    android:padding="@dimen/_8sdp"
                    app:tint="@color/primary"
                    android:contentDescription="Export PDF" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 3-Dots Menu Button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                app:cardCornerRadius="@dimen/_18sdp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/stitch_surface_container_low"
                app:strokeColor="@color/glass_border"
                app:strokeWidth="1dp">

                <ImageButton
                    android:id="@+id/btn_menu_notebook"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:src="@drawable/icon_threedots"
                    android:padding="@dimen/_7sdp"
                    app:tint="@color/text_secondary"
                    android:contentDescription="Notebook Options" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>


    <!-- CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_bar"
        android:layout_alignParentBottom="true"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/_140sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <!-- FILTER CHIPS RECYCLER VIEW -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/filter_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:layout_marginBottom="@dimen/_5sdp"
                tools:listitem="@layout/item_filter_chip"/>

            <!-- SUMMARY CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:strokeColor="@color/glass_border"
                app:strokeWidth="@dimen/_1sdp"
                app:cardCornerRadius="@dimen/_14sdp"
                app:contentPaddingRight="@dimen/_16sdp"
                app:contentPaddingLeft="@dimen/_16sdp"
                app:contentPaddingTop="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_12sdp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_8sdp">

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Net Balance"
                            android:textStyle="bold"
                            android:textSize="@dimen/_14ssp"
                            android:fontFamily="@font/roboto_regular"
                            android:textFontWeight="600"
                            android:textColor="@color/text_secondary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/tv_net_balance"
                            android:text="0"
                            android:fontFamily="@font/roboto_regular"
                            android:textFontWeight="600"
                            android:textStyle="bold"
                            android:textSize="@dimen/_14ssp"
                            android:textColor="@color/text_secondary"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/glass_border"
                        android:layout_marginBottom="@dimen/_8sdp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_8sdp">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Total In (+)"
                        android:fontFamily="@font/roboto_regular"
                        android:textFontWeight="600"
                        android:textStyle="bold"
                        android:textSize="@dimen/_12ssp"
                        android:textColor="@color/text_secondary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tv_total_in"
                        android:fontFamily="@font/roboto_regular"
                        android:textFontWeight="600"
                        android:text="Total In: 0"
                        android:textSize="@dimen/_12ssp"
                        android:textColor="@color/success"/>


                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Total Out (-)"
                        android:fontFamily="@font/roboto_regular"
                        android:textFontWeight="600"
                        android:textStyle="bold"
                        android:textSize="@dimen/_12ssp"
                        android:textColor="@color/text_secondary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tv_total_out"
                        android:text="Total Out: 0"
                        android:fontFamily="@font/roboto_regular"
                        android:textFontWeight="600"
                        android:textColor="@color/danger"
                        android:textSize="@dimen/_12ssp"
                        android:layout_marginBottom="@dimen/_12sdp"/>
                </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/glass_border"
                        android:layout_marginBottom="@dimen/_2sdp"/>

                    <Button
                        android:id="@+id/btn_view_reports"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VIEW REPORTS >"
                        android:fontFamily="@font/roboto_bold"
                        android:textFontWeight="600"
                        android:textSize="@dimen/_10ssp"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:textColor="@color/primary_color"
                        android:layout_gravity="center"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_entries_count"
                android:text="Showing 0 entries"
                android:textSize="@dimen/_10ssp"
                android:fontFamily="@font/roboto_regular"
                android:textFontWeight="600"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginBottom="@dimen/_2sdp"/>

            <!-- SHIMMER LOADERS -->
            <LinearLayout
                android:id="@+id/layoutShimmerTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <include layout="@layout/item_transaction_shimmer" />
                <include layout="@layout/item_transaction_shimmer" />
                <include layout="@layout/item_transaction_shimmer" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/transactions_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_transaction"/>

            <!-- EMPTY STATE TRANSACTIONS -->
            <LinearLayout
                android:id="@+id/layoutEmptyTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/_40sdp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="@dimen/_60sdp"
                    android:src="@drawable/ic_book"
                    android:alpha="0.2"
                    app:tint="@color/text_secondary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="No Transactions Yet"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/_14ssp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="Tap CASH IN or CASH OUT to start"
                    android:textColor="@color/text_secondary"
                    android:alpha="0.5"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- SCRIM FOR EXPANDED FAB MENU -->
    <View
        android:id="@+id/fab_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="@dimen/_6sdp" />

    <!-- FLOATING + SPEED-DIAL ACTION BUTTON -->
    <LinearLayout
        android:id="@+id/fab_menu_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_82sdp"
        android:orientation="vertical"
        android:gravity="end"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="@dimen/_10sdp">

        <!-- Cash Out Option -->
        <LinearLayout
            android:id="@+id/fab_cash_out_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/_12sdp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cash Out (-)"
                android:fontFamily="@font/roboto_bold"
                android:textSize="@dimen/_12ssp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_glass_card"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingVertical="@dimen/_6sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:elevation="@dimen/_4sdp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                app:cardCornerRadius="@dimen/_22sdp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/danger"
                app:strokeColor="#4DFFFFFF"
                app:strokeWidth="1.5dp">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_trans_minus"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Cash In Option -->
        <LinearLayout
            android:id="@+id/fab_cash_in_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/_14sdp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cash In (+)"
                android:fontFamily="@font/roboto_bold"
                android:textSize="@dimen/_12ssp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_glass_card"
                android:paddingHorizontal="@dimen/_12sdp"
                android:paddingVertical="@dimen/_6sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:elevation="@dimen/_4sdp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_44sdp"
                android:layout_height="@dimen/_44sdp"
                app:cardCornerRadius="@dimen/_22sdp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/success"
                app:strokeColor="#4DFFFFFF"
                app:strokeWidth="1.5dp">

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_trans_plus"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Main Round + Floating Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fab_add_transaction"
            android:layout_width="@dimen/_52sdp"
            android:layout_height="@dimen/_52sdp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:cardCornerRadius="@dimen/_26sdp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeWidth="0dp"
            android:contentDescription="Add Transaction">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_fab_round_gradient">

                <ImageView
                    android:id="@+id/iv_fab_icon"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add"
                    app:tint="@color/fab_tint" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</RelativeLayout>
