<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_glass"
    android:paddingHorizontal="@dimen/_16sdp"
    android:paddingTop="@dimen/_10sdp"
    android:paddingBottom="@dimen/_22sdp">

    <!-- Drag Handle -->
    <View
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_14sdp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Transaction Summary Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/_12sdp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="@dimen/_8sdp">

            <TextView
                android:id="@+id/tv_transaction_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transaction"
                android:fontFamily="@font/roboto_bold"
                android:textSize="@dimen/_14ssp"
                android:textColor="@color/text_secondary"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_transaction_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="Date &amp; Time"
                android:fontFamily="@font/roboto_regular"
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/on_surface_variant"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_transaction_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_10sdp"
            android:text="+ ₹0"
            android:fontFamily="@font/roboto_bold"
            android:textSize="@dimen/_14ssp"
            android:textColor="@color/success" />

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:scaleType="fitCenter"
            android:padding="@dimen/_4sdp"
            app:tint="@color/text_secondary"
            android:contentDescription="Close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/glass_border"
        android:layout_marginBottom="@dimen/_12sdp" />

    <!-- Edit Action Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="@dimen/_14sdp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card_bg"
        app:strokeColor="@color/glass_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_12sdp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bottom_nav_active_bg"
                app:strokeColor="@color/bottom_nav_active_border"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_action_edit"
                    app:tint="@color/primary" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginEnd="@dimen/_8sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit Transaction"
                    android:fontFamily="@font/roboto_bold"
                    android:textSize="@dimen/_13ssp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_1sdp"
                    android:text="Update amount, party, receipt or notes"
                    android:fontFamily="@font/roboto_regular"
                    android:textSize="@dimen/_10ssp"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/on_surface_variant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Delete Action Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_delete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="@dimen/_14sdp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card_bg"
        app:strokeColor="@color/glass_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_12sdp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/error_container"
                app:strokeColor="@color/danger"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_action_delete"
                    app:tint="@color/danger" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginEnd="@dimen/_8sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delete Transaction"
                    android:fontFamily="@font/roboto_bold"
                    android:textSize="@dimen/_13ssp"
                    android:textColor="@color/danger" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_1sdp"
                    android:text="Permanently remove this entry"
                    android:fontFamily="@font/roboto_regular"
                    android:textSize="@dimen/_10ssp"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/danger" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
