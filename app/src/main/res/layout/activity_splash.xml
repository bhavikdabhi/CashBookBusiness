<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    tools:context=".splash.SplashActivity">

    <!-- Centered Logo and Brand Info -->
    <LinearLayout
        android:id="@+id/splash_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Outer MaterialCardView for Glassmorphism Ring/Glow -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/logo_container"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:cardCornerRadius="50dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_container_high"
            app:strokeColor="@color/glass_border"
            app:strokeWidth="1.5dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_cash_volate"
                app:tint="@color/primary"
                android:contentDescription="@string/app_name" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Brand Name -->
        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:fontFamily="@font/roboto_bold"
            android:textSize="32sp"
            android:textColor="@color/primary"
            android:layout_marginTop="20dp" />

        <!-- Subtitle/Tagline -->
        <TextView
            android:id="@+id/app_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Business Ledger"
            android:fontFamily="@font/roboto_regular"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.1" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
