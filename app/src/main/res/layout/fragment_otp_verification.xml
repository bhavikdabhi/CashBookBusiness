<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Glowing Background -->
        <ImageView
            android:id="@+id/imgSmoke"
            android:layout_width="@dimen/_200sdp"
            android:layout_height="@dimen/_200sdp"
            android:src="@drawable/smoke_bg_top"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="-90dp"
            android:layout_marginStart="-90dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="@dimen/_20sdp">

            <TextView
                android:id="@+id/tv_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verify OTP"
                android:fontFamily="@font/roboto_bold"
                android:textSize="@dimen/_24ssp"
                android:textColor="@color/auth_accent_light"
                android:layout_marginTop="@dimen/_24sdp"
                android:layout_marginStart="@dimen/_16sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16sdp"
                android:fontFamily="@font/roboto_bold"
                android:text="Verification"
                android:textColor="@color/auth_glow_2"
                android:textSize="@dimen/_18ssp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_welcome" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:text="Please enter the 6-digit OTP code sent to your email."
                android:fontFamily="@font/roboto_regular"
                android:textColor="@color/auth_text_light"
                android:textSize="@dimen/_12ssp"
                app:layout_constraintTop_toBottomOf="@id/tv_back"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/auth_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:background="@drawable/bg_auth_card"
                android:padding="@dimen/_16sdp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

                <!-- OTP CODE -->
                <TextView
                    android:id="@+id/lbl_otp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter Verification Code"
                    android:fontFamily="@font/roboto_regular"
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/auth_text_light"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <EditText
                    android:id="@+id/et_otp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="@dimen/_16sdp"
                    android:hint="123456"
                    android:textColorHint="@color/dark_gray"
                    android:textColor="@color/text_secondary"
                    android:drawableStart="@drawable/ic_auth_lock"
                    android:drawablePadding="@dimen/_10sdp"
                    android:drawableTint="@color/auth_text_light"
                    android:inputType="number"
                    android:fontFamily="@font/roboto_regular"
                    android:textSize="@dimen/_14ssp"
                    android:textAlignment="center"
                    android:maxLength="6"
                    app:layout_constraintTop_toBottomOf="@id/lbl_otp" />

                <!-- Verify Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_verify"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_45sdp"
                    android:background="@drawable/bg_gradient_button"
                    android:text="Verify &amp; Register"
                    android:textColor="@color/auth_bg"
                    android:fontFamily="@font/roboto_bold"
                    android:textSize="@dimen/_13ssp"
                    android:textAllCaps="false"
                    android:elevation="@dimen/_16sdp"
                    android:outlineAmbientShadowColor="@color/auth_glow_1"
                    android:outlineSpotShadowColor="@color/auth_glow_1"
                    android:layout_marginTop="@dimen/_24sdp"
                    app:layout_constraintTop_toBottomOf="@id/et_otp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/layout_resend_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_20sdp"
                android:padding="@dimen/_4sdp"
                app:layout_constraintTop_toBottomOf="@id/auth_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Didn't receive the OTP? "
                    android:fontFamily="@font/roboto_regular"
                    android:textColor="@color/auth_text_light"
                    android:textSize="@dimen/_12ssp" />

                <TextView
                    android:id="@+id/tv_resend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resend Code"
                    android:textColor="@color/auth_glow_2"
                    android:fontFamily="@font/roboto_medium"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/imgSmokebottom"
            android:layout_width="@dimen/_200sdp"
            android:layout_height="@dimen/_200sdp"
            android:layout_marginEnd="-70dp"
            android:layout_marginBottom="-70dp"
            android:src="@drawable/smoke_bg_bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
